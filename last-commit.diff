+  <p class="text-gray-600"><%= it.t('views.comments.empty') %></p>
+  <% } else { %>
+  <div class="space-y-4">
+    <% it.comments.forEach((comment) => { %>
+    <%~ include("../comments/comment", { comment }) %>
+    <% }) %>
+  </div>
+  <% } %>
+
+  <div class="mt-8">
+    <%~ include("../comments/form", {
+      article: it.article,
+      comment: it.comment ?? {},
+      errors: it.errors,
+    }) %>
+  </div>
+</section>
