//- Раньше имя сущности выводилось из entity.constructor.name: модели Sequelize
//- давали Article. После перехода на drizzle записи это обычные объекты, у
//- которых constructor.name равен Object, и ключи переводов уехали бы в
//- views.object.*. Приложение оперирует одной сущностью, поэтому имя задано
//- явно, а не угадывается по классу.
- const getEntityName = () => 'article'
- const getInputName = (property) => `data[${property}]`
- const getInputId = (property) => `data_${property}`
- const getValue = (entity, property) => (entity && entity[property]) || ''
- const getError = (errors, propertyName) => errors.find((error) => error.path === propertyName)
- const getErrorText = (errors, propertyName) => errors.filter((error) => error.path === propertyName).map(({ message }) => message).join('. ')
- const fieldClass = 'w-full rounded border border-gray-300 px-3 py-2'
- const invalidClass = 'border-red-500'

mixin formFor(entity = null)
  form.mb-6&attributes(attributes)
    block

mixin input(entity, propertyName, errors = [])
  - error = getError(errors, propertyName)
  - inputName = getInputName(propertyName)
  - inputId = getInputId(propertyName)
  - entityName = getEntityName(entity)
  .mb-4
    label.mb-1.block.text-sm.font-medium(
      for= inputId
    )= t(`views.${entityName}.${propertyName}.label`)
    input(
      id= inputId
      name= inputName
      class=[fieldClass, error && invalidClass]
      value=getValue(entity, propertyName)
    )&attributes(attributes)
    if error
      p.mt-1.text-sm.text-red-600= getErrorText(errors, propertyName)

mixin textarea(entity, propertyName, errors = [])
  - error = getError(errors, propertyName)
  - inputName = getInputName(propertyName)
  - inputId = getInputId(propertyName)
  - entityName = getEntityName(entity)
  .mb-4
    label.mb-1.block.text-sm.font-medium(
      for= inputId
    )= t(`views.${entityName}.${propertyName}.label`)
    textarea(
      id= inputId
      name= inputName
      class=[fieldClass, error && invalidClass]
    )&attributes(attributes)= getValue(entity, propertyName)
    if error
      p.mt-1.text-sm.text-red-600= getErrorText(errors, propertyName)

mixin submit(form = null)
  input(
    type='submit'
    class='cursor-pointer rounded bg-blue-600 px-4 py-2 text-white'
  )&attributes(attributes)

mixin buttonTo(action, method)
  form(action=action, method="post")
    input(name="_method" type="hidden" value=method)
    input(type='submit')&attributes(attributes)
