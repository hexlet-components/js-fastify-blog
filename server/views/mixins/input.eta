<%
  // Имя сущности задано явно, а не выводится из entity.constructor.name:
  // после перехода на drizzle записи это обычные объекты, и ключи переводов
  // уехали бы в views.object.*. Приложение оперирует одной сущностью.
  const errors = it.errors ?? [];
  const errorText = errors
    .filter((error) => error.path === it.propertyName)
    .map(({ message }) => message)
    .join('. ');
  const inputId = `data_${it.propertyName}`;
  const fieldClass = 'w-full rounded border border-gray-300 px-3 py-2';
%>
<div class="mb-4">
  <label class="mb-1 block text-sm font-medium" for="<%= inputId %>"><%= it.t(`views.article.${it.propertyName}.label`) %></label>
  <input
    id="<%= inputId %>"
    name="data[<%= it.propertyName %>]"
    class="<%= fieldClass %><%= errorText ? ' border-red-500' : '' %>"
    type="<%= it.type ?? 'text' %>"
    value="<%= (it.entity && it.entity[it.propertyName]) || '' %>"
  >
  <% if (errorText) { %>
  <p class="mt-1 text-sm text-red-600"><%= errorText %></p>
  <% } %>
</div>
