include ../mixins/forms.pug
include ../mixins/article.pug

doctype html
html(lang="en")
  head
    title Hexlet Fastify Blog
    link(href=assetPath('main.css') rel="stylesheet")
    meta(name="viewport" content="width=device-width, initial-scale=1")
  body.flex.min-h-screen.flex-col.bg-white.text-gray-900
    nav.border-b.border-gray-200.bg-gray-50
      .mx-auto.flex.max-w-5xl.items-center.gap-6.px-4.py-3
        a.text-lg.font-semibold(href=route('root'))= t('appName')
        a.text-sm.text-gray-600(href=route('articles'))= t('layouts.application.articles')
    .mx-auto.w-full.max-w-5xl.flex-1.px-4
      each messages, type in reply.flash() || []
        each message in messages
          div(class=`mb-4 rounded border px-4 py-3 ${getAlertClass(type)}`)= message

      h1.my-6.text-3xl.font-bold
        block header
      block content

    footer.mt-10.border-t.border-gray-200
      .mx-auto.max-w-5xl.px-4.py-6
        a.text-sm.text-gray-600(target="_blank" href="https://ru.hexlet.io") Hexlet
