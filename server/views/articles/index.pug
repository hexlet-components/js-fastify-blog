extends ../layouts/application.pug

block header
  = t('views.articles.index.header')
block content
  a.inline-block.rounded.bg-blue-600.px-4.py-2.text-white(href=route('newArticle'))= t('views.articles.index.new')
  table.mt-6.w-full.text-left
    thead.border-b.border-gray-300
      tr
        th.py-2= t('views.articles.index.id')
        th.py-2= t('views.articles.index.title')
        th.py-2= t('views.articles.index.createdAt')
        th.py-2= t('views.articles.index.actions')

    tbody
      each article in articles
        tr.border-b.border-gray-200
          td.py-2= article.id
          td.py-2= article.title
          td.py-2= formatDate(article.createdAt)
          td.py-2
            .flex.items-center.gap-4
              a.text-blue-600(href=route('article', { id: article.id }))= t('layouts.actions.view')
              a.text-blue-600(href=route('editArticle', { id: article.id }))= t('layouts.actions.edit')
              +buttonTo(route('article', { id: article.id }), 'delete')(
                value=t('layouts.actions.delete')
                class="cursor-pointer text-red-600"
                onclick=`return confirm('${t('views.articles.index.delete_confirmation')}')`
              )
